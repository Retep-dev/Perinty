{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build -- --outDir ../dist",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,backend/venv/**,.venv/**,**/__pycache__/**,**/.env,**/.env.*,backend/tests/**,backend/test_*,backend/debug_*,backend/diagnose_*,.git/**,.github/**,docs/**}"
    }
  }
}
