# -----------------------------------------------------------------------------
# Perinty RAG Customer Support API Configurations
# -----------------------------------------------------------------------------

# [REQUIRED] Gemini LLM and Embedding API Key
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Supabase Configs
# Leave blank to fall back to in-memory vector indexing (zero-config local mode)
SUPABASE_URL=
SUPABASE_KEY=
