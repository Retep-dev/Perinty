# -----------------------------------------------------------------------------
# Perinty RAG Customer Support API Configurations
# -----------------------------------------------------------------------------

# [REQUIRED] NVIDIA NIM API Key
# Get a key from NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# [OPTIONAL] Supabase Configs
# Leave blank to fall back to in-memory vector indexing (zero-config local mode)
SUPABASE_URL=
SUPABASE_KEY=
