# -----------------------------------------------------------------------------
# Perinty RAG Customer Support API Configurations
# -----------------------------------------------------------------------------

# [REQUIRED] NVIDIA NIM API Key
# Get a key from NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# [REQUIRED FOR PHASE 2] Supabase Configs
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# [OPTIONAL] Model configuration; do not mix vectors from different models.
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_UPLOAD_BYTES=4000000
MAX_DOCUMENT_CHARS=200000
MAX_DOCUMENT_CHUNKS=100
# Empty for same-origin Vercel or the Vite development proxy.
CORS_ORIGINS=

# [OPTIONAL] Langfuse LLM Observability & Monitoring
# Get keys from Langfuse Cloud (https://cloud.langfuse.com) or self-hosted instance
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
